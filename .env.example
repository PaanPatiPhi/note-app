# คัดลอกเป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)

# LINE Messaging API (บอท)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Login channel ID (ใช้ verify LIFF id_token)
LIFF_CHANNEL_ID=

# Google OAuth Client ID
GOOGLE_CLIENT_ID=

# Postgres (Supabase Transaction Pooler)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# ใช้โดย internal/database (แบบเก่า) เท่านั้น
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=

# Web app origin(s) สำหรับ CORS คั่นด้วย comma
WEB_ORIGIN=http://localhost:3000

# Session JWT — ต้องตั้งเสมอ ยาวอย่างน้อย 32 ตัวอักษร (สร้างด้วย `openssl rand -base64 48`) ไม่งั้น server ไม่ start
JWT_SECRET=
# ENV=production: cookie แบบ Secure, CORS เฉพาะ WEB_ORIGIN (ไม่รับ localhost), เปิด HSTS
ENV=
# IP ของ proxy/load balancer ที่เชื่อ X-Forwarded-For (คั่นด้วย comma) ว่าง = ไม่เชื่อใคร ใช้ IP ที่ต่อเข้ามาตรงๆ
TRUSTED_PROXIES=

PORT=8080

# AI assistant ใน LINE: AI_PROVIDER=ollama (ค่าเริ่มต้น, local) หรือ claude
AI_PROVIDER=
# Claude API (ใช้เมื่อ AI_PROVIDER=claude)
ANTHROPIC_API_KEY=
# ไม่ตั้ง = qwen3:4b-instruct (ollama) หรือ claude-opus-5-5 (claude)
AI_MODEL=
# ใช้เมื่อ AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# เวลาที่ Ollama เก็บโมเดลไว้ใน GPU (ค่าเริ่มต้น 24h, "-1" = ตลอด)
OLLAMA_KEEP_ALIVE=

# Google Calendar (เชื่อมจากหน้า /account บนเว็บ)
# ใช้ GOOGLE_CLIENT_ID ตัวเดียวกับ login แต่ต้องเพิ่ม secret และ redirect URI ใน Google Cloud Console
GOOGLE_CLIENT_SECRET=
# ไม่ตั้ง = http://localhost:8080/api/integrations/google/callback
GOOGLE_REDIRECT_URL=
# key สำหรับเข้ารหัส token ใน DB: openssl rand -base64 32
INTEGRATIONS_KEY=
